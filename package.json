{
  "name": "sentinel-strike-team",
  "version": "0.1.0",
  "private": true,
  "description": "SENTINEL - an autonomous supply-chain CVE strike team built on the TrueForge agent harness",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "sentinel": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "node --experimental-strip-types src/mcp/server.ts",
    "cli": "node --experimental-strip-types src/cli/index.ts",
    "web": "node --experimental-strip-types src/web/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "scan:secrets": "node --experimental-strip-types scripts/scan-secrets.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "hono": "^4.12.34",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
