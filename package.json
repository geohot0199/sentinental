{
  "name": "sentinel-strike-team",
  "version": "1.0.0",
  "private": true,
  "description": "SENTINEL OMNI-LAB - The World's First 5-in-1 Agent-Native Frontier Operating System built on the W3C/OpenAI WebMCP Standard",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "sentinel": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "node --experimental-strip-types src/mcp/server.ts",
    "cli": "node --experimental-strip-types src/cli/index.ts",
    "web": "node --experimental-strip-types src/web/server.ts",
    "site:dev": "node site/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "scan:secrets": "node --experimental-strip-types scripts/scan-secrets.ts",
    "app": "node --experimental-strip-types --no-warnings src/server/api.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "hono": "^4.12.34",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
