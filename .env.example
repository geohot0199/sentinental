# SENTINEL configuration.
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ─── Model provider (one is required) ────────────────────────────────────────
# SENTINEL picks the first key it finds, in this order. Set MODEL_PROVIDER to
# force a specific one.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Force a provider: openai | anthropic | google-gemini
# MODEL_PROVIDER=openai

# Force a specific model. Must be a model name the harness catalog offers.
# Leave unset and SENTINEL picks a sensible mid-tier model automatically.
# MODEL_ID=

# ─── GitHub (required to scan repositories and open pull requests) ───────────
# A fine-grained personal access token. Minimum scopes:
#   Contents: read and write   (to read manifests and commit a fix branch)
#   Pull requests: read and write
# Grant it access ONLY to the repositories you want SENTINEL to touch.
GITHUB_TOKEN=

# Default repository to triage, as owner/name.
SENTINEL_TARGET_REPO=

# ─── Sandbox (optional but strongly recommended) ─────────────────────────────
# Without this the agent cannot execute or test a patch, and is instructed to
# report every patch as UNVERIFIED. Free tier: https://daytona.io
DAYTONA_API_KEY=

# ─── Safety ──────────────────────────────────────────────────────────────────
# Hard kill switch. When false, destructive tools refuse before any network
# call, regardless of what the model or the approval UI says.
# Set false for a safe demo run.
SENTINEL_ALLOW_REMOTE_WRITES=true

# ─── Networking (defaults are fine for local use) ────────────────────────────
# TRUEFORGE_URL=http://127.0.0.1:8790
# SENTINEL_MCP_PORT=8791
# SENTINEL_WEB_PORT=3000

# Shared secret the harness uses to call SENTINEL's tool server.
# Leave unset and a fresh random token is generated on every boot.
# SENTINEL_MCP_TOKEN=
