# SENTINEL configuration.
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Everything here is read in exactly one place — src/core/config.ts — so this
# file and the Configuration table in README.md are the whole surface. A test
# (tests/env-example.test.ts) fails the build if a variable appears in the
# source and not here.

# ─── Model provider (one is required) ────────────────────────────────────────
# SENTINEL picks the first key it finds, in this order. Set MODEL_PROVIDER to
# force a specific one.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Force a provider: openai | anthropic | google-gemini
# MODEL_PROVIDER=openai

# Force a specific model. Must be a model name the harness catalog offers.
# Leave unset and SENTINEL picks a sensible mid-tier model automatically.
# MODEL_ID=

# ─── GitHub (required to scan repositories and open pull requests) ───────────
# A fine-grained personal access token. Minimum scopes:
#   Contents: read and write   (to read manifests and commit a fix branch)
#   Pull requests: read and write
# Grant it access ONLY to the repositories you want SENTINEL to touch.
GITHUB_TOKEN=

# Default repository to triage, as owner/name.
SENTINEL_TARGET_REPO=

# ─── Sandbox (optional but strongly recommended) ─────────────────────────────
# Without this the agent cannot execute or test a patch, and is instructed to
# report every patch as UNVERIFIED. Free tier: https://daytona.io
DAYTONA_API_KEY=

# ─── Safety ──────────────────────────────────────────────────────────────────
# Hard kill switch. When false, destructive tools refuse before any network
# call, regardless of what the model or the approval UI says.
# Set false for a safe demo run.
SENTINEL_ALLOW_REMOTE_WRITES=true

# ─── Networking (defaults are fine for local use) ────────────────────────────
# Base URL of the running TrueForge harness.
# TRUEFORGE_URL=http://127.0.0.1:8790

# Port SENTINEL's own MCP tool server listens on.
# SENTINEL_MCP_PORT=8791

# URL the harness is told to reach the tool server at. Set this when the
# harness runs somewhere that cannot use 127.0.0.1 to reach us.
# SENTINEL_MCP_URL=http://127.0.0.1:8791/mcp

# Web console port (`npm run web`).
# SENTINEL_WEB_PORT=3000

# Port override read by the standalone API app (`npm run app`) and by the
# landing-page server (`npm run site:dev`, default 4321 there). Falls back to
# SENTINEL_WEB_PORT for the API app.
# PORT=3000

# ─── Local state ─────────────────────────────────────────────────────────────
# SQLite file holding the API app's scan history.
# SENTINEL_DB=.sentinel/sentinel.db

# ─── Secrets and demo plumbing ───────────────────────────────────────────────
# Shared secret the harness uses to call SENTINEL's tool server.
# Leave unset and a fresh random token is generated on every boot.
# SENTINEL_MCP_TOKEN=

# Point at the bundled scripted model for a keyless demo run.
# SENTINEL_DEMO_MODEL_URL=http://127.0.0.1:8899/v1

# Used only by scripts/e2e-approval.ts, which drives that scripted model.
# MOCK_MODEL_URL=http://127.0.0.1:8899/v1

# ─── Terminal output ─────────────────────────────────────────────────────────
# Set to anything (NO_COLOR=1) to force plain text in the CLI. Colour is
# already off when stdout is not a TTY. See https://no-color.org
# NO_COLOR=1
